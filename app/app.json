{
  "expo": {
    "name": "MostBox",
    "slug": "mostbox",
    "version": "0.5.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "most",
    "extra": {
      "product": "most"
    },
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "android": {
      "versionCode": 503,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "most.box",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.google.android.c2dm.permission.RECEIVE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "most"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "most.box",
      "buildNumber": "503",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "按住说话时使用麦克风录制你选择发送的语音消息。",
        "NSCameraUsageDescription": "使用相机拍摄你选择发送的照片。",
        "NSPhotoLibraryUsageDescription": "选择你希望发送的照片。",
        "NSLocalNetworkUsageDescription": "MostBox 使用本地网络发现并连接其他设备，以传输文件。",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "plugins": [
      "./scripts/with-local-notifications.mjs",
      ["expo-notifications", { "enableBackgroundRemoteNotifications": false }],
      [
        "expo-audio",
        {
          "microphonePermission": "按住说话时使用麦克风录制你选择发送的语音消息。",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "使用相机拍摄你选择发送的照片。",
          "photosPermission": "选择你希望发送的照片。",
          "microphonePermission": "按住说话时使用麦克风录制你选择发送的语音消息。"
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 31,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing"
    ]
  }
}
