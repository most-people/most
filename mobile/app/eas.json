{
  "build": {
    "android-preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "android-production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-production-mohe": {
      "extends": "android-production",
      "env": {
        "MOST_PRODUCT": "inkbox",
        "EXPO_PUBLIC_MOST_PRODUCT": "inkbox"
      }
    },
    "ios-development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      }
    },
    "ios-simulator": {
      "extends": "ios-development",
      "ios": {
        "simulator": true
      }
    },
    "ios-preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "ios-production": {
      "distribution": "store",
      "environment": "production"
    },
    "ios-production-mohe": {
      "extends": "ios-production",
      "env": {
        "MOST_PRODUCT": "inkbox",
        "EXPO_PUBLIC_MOST_PRODUCT": "inkbox"
      }
    }
  }
}
