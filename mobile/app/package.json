{
  "name": "@most-box/app",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "npm run bundle:android && node scripts/start-dev-client.mjs",
    "start:ios": "npm run bundle:ios && expo start --dev-client --host lan",
    "ios": "npm run bundle:ios && expo run:ios",
    "build": "node scripts/build-apk.mjs",
    "build:release": "node scripts/build-apk.mjs --signed-release-apk",
    "build:emulator": "node scripts/build-apk.mjs --emulator-apk",
    "build:store": "node scripts/build-apk.mjs --store-apk",
    "build:play": "node scripts/build-apk.mjs --aab",
    "bundle:android": "node scripts/bundle-bare.mjs --platform android",
    "bundle:ios": "node scripts/bundle-bare.mjs --platform ios",
    "eas-build-post-install": "node scripts/bundle-bare.mjs",
    "sync:native": "node scripts/sync-native-android.mjs",
    "test": "node --import tsx --test src/mobileCore/cid.test.ts src/mobileCore/protocol.test.ts src/mobileCore/storeFilePolicy.test.ts src/features/knowledge/knowledgeModel.test.ts src/features/knowledge/knowledgeRepository.test.ts src/i18n/messages.test.ts src/ui/presentation.test.ts && node --test backend/protocol.test.mjs backend/p2p-ping.test.mjs backend/holding-records.test.mjs backend/mobile-core.test.mjs backend/node-crypto-shim.test.mjs scripts/sync-native-android.test.mjs scripts/verify-apk-signature.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "b4a": "1.8.1",
    "bare-fs": "4.8.0",
    "corestore": "7.12.0",
    "expo": "~57.0.10",
    "expo-build-properties": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "hyperdrive": "13.3.3",
    "hyperswarm": "4.17.0",
    "ipfs-unixfs-importer": "17.0.1",
    "lucide-react-native": "1.28.0",
    "multiformats": "14.0.5",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-bare-kit": "0.15.0",
    "react-native-enriched-markdown": "0.7.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/b4a": "1.6.5",
    "@types/react": "19.2.18",
    "bare-pack": "^2.2.1",
    "tsx": "4.23.5",
    "typescript": "6.0.3"
  }
}
